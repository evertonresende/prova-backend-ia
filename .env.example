# Obrigatória só para a Q2 (chatbot).
OPENAI_API_KEY=
# Opcional. Padrão: gpt-6-luna. Não use gpt-4: a OpenAI desligou esse modelo em 23/10/2026.
OPENAI_MODEL=gpt-6-luna

# Opcional: tracing no LangSmith. "true" em minúsculo ("True" não liga).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Escolha UM destino, nunca os dois (com os dois, o SDK para de registrar traces):
# a) workspace por projeto (o mais comum)
LANGSMITH_PROJECT=prova-backend-ia
# b) workspace por agente
# LANGSMITH_AGENT_ID=
# LANGSMITH_AGENT_ENVIRONMENT=
# Opcional: conta do LangSmith fora dos EUA
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Opcional: arquivo SQLite da Q1.
LIVROS_DB_PATH=livros.db
